{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/NexoGestao.Api", "--launch-profile", "http"],
      "port": 5104
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/nexogestao-web", "run", "dev", "--", "-p", "3000"],
      "port": 3000
    }
  ]
}
