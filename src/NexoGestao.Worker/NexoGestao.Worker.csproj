<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexoWorker</AssemblyName>
    <RootNamespace>NexoGestao.Worker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Mesmo código de leitura da página pública e de roteiro usado antes dentro da API;
       compartilhado por link de arquivo, sem referenciar o projeto web. -->
  <ItemGroup>
    <Compile Include="..\NexoGestao.Api\Shared\ShopeeMetadataFetcher.cs" Link="Compartilhado\ShopeeMetadataFetcher.cs" />
    <Compile Include="..\NexoGestao.Api\Shared\RoteiroAutomatico.cs" Link="Compartilhado\RoteiroAutomatico.cs" />
  </ItemGroup>

</Project>
